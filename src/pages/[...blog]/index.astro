---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink, getBlogPermalink } from '~/utils/permalinks';
import {
  getStaticPathsBlogPost,
  blogPostRobots,
  isBlogListRouteEnabled,
  isBlogCategoryRouteEnabled,
} from '~/utils/blog';
import { findImage, adaptOpenGraphImages } from '~/utils/images';
import type { MetaData } from '~/types';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import { headerData } from '~/navigation';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

/**
 * Description pour les moteurs : l'extrait complet jusqu'à 300 caractères (Google n'impose pas de limite).
 * Au-delà, coupe à la dernière fin de phrase, à défaut au dernier mot, sans points de suspension.
 */
const MAX_DESCRIPTION = 300;
const toDescription = (text = ''): string => {
  const clean = text.replace(/\s+/g, ' ').trim();
  if (clean.length <= MAX_DESCRIPTION) return clean;
  const head = clean.slice(0, MAX_DESCRIPTION + 1);
  const sentenceEnd = Math.max(head.lastIndexOf('. '), head.lastIndexOf('! '), head.lastIndexOf('? '));
  if (sentenceEnd > MAX_DESCRIPTION / 2) return head.slice(0, sentenceEnd + 1);
  const wordEnd = head.lastIndexOf(' ');
  return head.slice(0, wordEnd > 0 ? wordEnd : MAX_DESCRIPTION).replace(/[\s,;:.-]+$/, '');
};

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

// Single-author blog: posts without an explicit author fall back to the site owner.
const authorName = post.author || 'Jonathan Cattelain';
const authorSameAs = [
  headerData.contact.href,
  ...headerData.socials.filter((s) => s.ariaLabel === 'GitHub').map((s) => s.href),
];

const metadata = merge(
  {
    title: post.title,
    description: toDescription(post.excerpt),
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      article: {
        publishedTime: post.publishDate.toISOString(),
        modifiedTime: (post.updateDate ?? post.publishDate).toISOString(),
        authors: [String(getCanonical(getPermalink('/about')))],
        ...(post.category ? { section: post.category.title } : {}),
        ...(post.tags?.length ? { tags: post.tags.map((tag) => tag.title) } : {}),
      },
      ...(image
        ? {
            images: [
              {
                url: image,
                width: (image as ImageMetadata)?.width,
                height: (image as ImageMetadata)?.height,
                alt: post.imageAlt || post.title,
              },
            ],
          }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

// Same optimized 1200x627 JPG as og:image, so LinkedIn and search engines see one cover.
const imageUrl = (await adaptOpenGraphImages({ images: image ? [{ url: image as string }] : [] }, Astro.site))
  .images?.[0]?.url;

// Article structured data. The breadcrumb trail below carries its own BreadcrumbList.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updateDate ?? post.publishDate).toISOString(),
  inLanguage: I18N?.language,
  author: {
    '@type': 'Person',
    name: authorName,
    url: String(getCanonical(getPermalink('/about'))),
    sameAs: authorSameAs,
  },
  publisher: { '@type': 'Organization', name: SITE?.name },
  ...(imageUrl ? { image: imageUrl } : {}),
  ...(post.category ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.map((tag) => tag.title).join(', ') } : {}),
  mainEntityOfPage: String(url),
};

const breadcrumbs = [
  { text: 'Accueil', href: getPermalink('/') },
  ...(isBlogListRouteEnabled ? [{ text: 'Blog', href: getBlogPermalink() }] : []),
  ...(post.category && isBlogCategoryRouteEnabled
    ? [{ text: post.category.title, href: getPermalink(post.category.slug, 'category') }]
    : []),
  { text: post.title },
];
---

<Layout metadata={metadata}>
  <meta slot="head" name="author" content={authorName} />
  <StructuredData slot="head" schema={articleSchema} />
  <Breadcrumbs bar hideCurrent items={breadcrumbs} />
  <SinglePost post={{ ...post, image: image }} url={url}>
    {post.Content && <post.Content />}
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
