---
import Layout from '~/layouts/PageLayout.astro';
import CvSheet from '~/components/common/CvSheet.astro';
import { profile, education, teaching, certifications, skills, employers } from '~/data/cv';
import photo from '~/assets/images/photo-profil.jpg';

const metadata = {
  title: `CV — ${profile.name}`,
  ignoreTitleTemplate: true,
  description: `${profile.name}, ${profile.title}. Parcours, compétences et expériences.`,
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <CvSheet {profile} {education} {teaching} {certifications} {skills} {employers} {photo}>
    <Fragment slot="toolbar">
      <button type="button" class="btn-primary cv-print" onclick="window.print()">Imprimer / enregistrer en PDF</button>
    </Fragment>
  </CvSheet>
</Layout>
