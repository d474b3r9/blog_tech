---
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<Font cssVariable="--font-newsreader" />

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Updated <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-lg md:text-xl text-muted dark:text-slate-400 text-pretty"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl post-prose prose dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tight prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>

<dialog
  id="post-lightbox"
  class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none cursor-zoom-out flex-col items-center justify-center gap-4 bg-black/90 p-4 open:flex backdrop:bg-black/90"
  aria-label="Image agrandie"
>
  <img alt="" class="h-[78vh] w-[95vw] rounded-md object-contain" />
  <p id="post-lightbox-caption" class="max-w-3xl px-4 text-center text-sm text-slate-200"></p>
</dialog>

<style is:global>
  .prose.post-prose {
    --post-serif: var(--font-newsreader), Newsreader, Georgia, serif;
    max-width: 42rem;
    font-family: var(--post-serif);
    font-size: 1.1875rem;
    line-height: 1.7;
  }
  .prose.post-prose :is(h1, h2, h3, h4) {
    font-family: var(--post-serif);
    font-weight: 700;
  }
  .prose.post-prose :is(code, pre, kbd) {
    font-family: ui-monospace, Consolas, monospace;
  }
  .prose.post-prose :is(figcaption) {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 0.8125rem;
  }
  .prose .tldr {
    margin: 0 0 2rem;
    padding: 1.1rem 1.4rem 0.6rem;
    border: 1px solid color-mix(in oklab, var(--aw-color-text-default) 14%, transparent);
    border-left: 3px solid #c09a6b;
    border-radius: 0.5rem;
    background: color-mix(in oklab, #c09a6b 8%, transparent);
    font-size: 0.95em;
    line-height: 1.6;
  }
  .prose .tldr > p:first-child {
    margin-top: 0;
  }
  .prose .tldr ul {
    margin: 0.4rem 0 0.6rem;
  }
  /* Encart de définition : explique un terme technique, sur fond bleu */
  .prose .definition {
    margin: 1.5rem 0;
    padding: 0.9rem 1.3rem 0.5rem;
    border: 1px solid color-mix(in oklab, #3b82f6 28%, transparent);
    border-left: 3px solid #3b82f6;
    border-radius: 0.5rem;
    background: color-mix(in oklab, #3b82f6 9%, transparent);
    font-size: 0.93em;
    line-height: 1.6;
  }
  .prose .definition > p:first-child {
    margin-top: 0;
    color: #2563eb;
  }
  .prose .definition ul {
    margin: 0.4rem 0 0.6rem;
  }
  :is(.dark) .prose .definition > p:first-child {
    color: #93c5fd;
  }
  /* Tableaux compacts : lisibles sans occuper la page */
  .prose.post-prose table {
    width: 100%;
    margin: 1.25rem 0 0.5rem;
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .prose.post-prose :is(th, td) {
    padding: 0.3rem 0.65rem;
  }
  .prose.post-prose thead th {
    padding-bottom: 0.4rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .prose.post-prose tbody td:not(:first-child) {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    /* Sur téléphone, un tableau plus large que l'écran défile au lieu d'être coupé */
    .prose.post-prose table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .prose.post-prose :is(th, td):first-child {
      white-space: nowrap;
    }
  }
  .prose img {
    cursor: zoom-in;
  }
  .zoomable {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .zoomable-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 0;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
    cursor: zoom-in;
    opacity: 0.75;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .zoomable:hover .zoomable-btn,
  .zoomable-btn:focus-visible {
    opacity: 1;
    transform: scale(1.08);
  }
</style>

<script>
  const lightbox = document.getElementById('post-lightbox') as HTMLDialogElement | null;
  const target = lightbox?.querySelector('img');
  const caption = document.getElementById('post-lightbox-caption');

  const ZOOM_ICON =
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>';

  if (lightbox && target) {
    const open = (img: HTMLImageElement) => {
      target.src = img.currentSrc || img.src;
      target.alt = img.alt;
      if (caption) caption.textContent = img.alt;
      lightbox.showModal();
    };

    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      const wrapper = document.createElement('span');
      wrapper.className = 'zoomable';
      img.replaceWith(wrapper);
      wrapper.appendChild(img);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'zoomable-btn';
      btn.title = "Agrandir l'image";
      btn.setAttribute('aria-label', "Agrandir l'image");
      btn.innerHTML = ZOOM_ICON;
      wrapper.appendChild(btn);

      img.addEventListener('click', () => open(img));
      btn.addEventListener('click', () => open(img));
    });

    lightbox.addEventListener('click', () => lightbox.close());
  }
</script>
